{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FIDO-LABS",
  "version": "3.0.0",
  "identifier": "com.fido-labs.forensic",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FIDO-LABS v3 — Forensic Tool",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "© 2024 FIDO-LABS",
    "shortDescription": "Forensic Extraction & Analysis — v3",
    "longDescription": "FIDO-LABS v3 — Forensic Integrated Data Operator. Extraction et analyse forensique numérique locale.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
